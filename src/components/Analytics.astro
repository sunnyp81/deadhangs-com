      if (canonical) {
        try {
          var canonicalUrl = new URL(canonical, window.location.origin);
          canonicalUrl.search = '';
          canonicalUrl.hash = '';
          canonical = canonicalUrl.href;
        } catch (_) {
          canonical = null;
        }
      }
      // page_location stays path-only. page_referrer is always set, so gtag never falls back to the full document.referrer.
      var config = {
        page_location: canonical || window.location.origin + window.location.pathname,
        page_referrer: safeReferrer(document.referrer, window.location.hostname)
      };
      var campaign = campaignFields(window.location.search);
      if (campaign) for (var key in campaign) config[key] = campaign[key];
      window.gtag('config', id, config);
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
      document.head.appendChild(script);
    };
    try { if (localStorage.getItem('cookieConsent') === 'accepted') window.__gaLoad(); } catch (_) {}
    window.addEventListener('storage', function (event) {
      if (event.key === 'cookieConsent' || event.key === null) window.dispatchEvent(new CustomEvent('deadhangs:consent', { detail: event.newValue === 'accepted' ? 'accepted' : 'declined' }));
    });
    window.addEventListener('deadhangs:consent', function (event) {
      if (event.detail === 'accepted') window.__gaLoad();
      else {
        window['ga-disable-' + id] = true;
        document.cookie.split(';').forEach(function (part) {
          var name = part.trim().split('=')[0];
          if (!/^_ga(?:_|$)/.test(name)) return;
          ['', ';domain=' + location.hostname, ';domain=.deadhangs.com'].forEach(function (domain) {
            document.cookie = name + '=;max-age=0;path=/' + domain + ';SameSite=Lax';
          });
        });
      }
    });
  })();
</script>
