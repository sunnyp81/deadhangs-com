 ['Weeks 5 and 6', 'Practice the revised setup', '3 sets at the revised hold', '60 to 90 seconds', 'Return to the previous setup if the new one is too demanding.'],
 ['Weeks 7 and 8', 'Compare both blocks', '3 sets at the setup that worked best', '60 to 90 seconds', 'Compare consistency and control as well as seconds, then choose the next block.'],
];
const week = [
 ['Monday', 'Hang session', 'Warm-up, 3 sets, 60 to 90 seconds of rest, record actual holds'],
 ['Tuesday', 'Rest', 'Optional mobility work'],
 ['Wednesday', 'Hang session', 'Same setup as Monday'],
 ['Thursday', 'Rest', 'Optional mobility work'],
 ['Friday', 'Hang session', 'Same setup. Review two comparable sessions at the end of weeks 4 and 8'],
 ['Saturday and Sunday', 'Rest', 'No hanging'],
];
const faqs = [
 { q: 'Who is the 8-week dead hang program for?', a: 'The 8-week program suits you once you can hold a comfortable 20 to 30 seconds. If you cannot yet, start with the 4-week program. It is a planning framework with review points and does not promise a particular hold time.' },
 { q: 'How many sessions a week does the 8-week dead hang program use?', a: 'Three sessions a week on non-consecutive days, for example Monday, Wednesday and Friday, with 3 sets and 60 to 90 seconds of rest. Add a session only if you stay pain free. This is common training practice, not a tested prescription.' },
