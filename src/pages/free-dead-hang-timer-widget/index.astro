---
import Article from '../../layouts/Article.astro';
import { buildEmbedCode, EMBED_LIMITS } from '../../lib/embed-params.mjs';

const L = EMBED_LIMITS;
const defaults = { work: L.work.def, rest: L.rest.def, rounds: L.rounds.def, theme: 'dark' };
const initialCode = buildEmbedCode('https://deadhangs.com', defaults);
const faqs = [
  { q: 'Is the dead hang timer widget free?', a: 'Yes. The widget is free to use on any website, with no account, no sign-up and no usage limit. You paste one block of HTML into your page. The credit line below the timer is optional, and the timer works the same with or without it.' },
  { q: 'Do I have to link back to DeadHangs.com?', a: 'No. The credit line is a courtesy, not a condition. If you keep it, it is a plain text line with one link to DeadHangs.com. If you remove it, the timer still works. The small "Timer by DeadHangs.com" link inside the frame stays as part of the widget.' },
  { q: 'Does the widget track or store anything about my visitors?', a: 'The widget stores nothing in the visitor\'s browser, sends no analytics and needs no account. Like any embedded page, loading it is a request to the DeadHangs.com host, which is how every iframe works. Timer settings are never sent anywhere.' },
  { q: 'What are the limits for hang time, rest and rounds?', a: 'Hang time runs from 5 to 120 seconds, rest from 10 to 300 seconds and rounds from 1 to 10. Values outside those limits are clamped to the nearest allowed value. Visitors can change all three inside the widget, so your settings are the starting values.' },
  { q: 'Will the timer fit a narrow column or a phone?', a: 'Yes. The widget lays out from 300 pixels wide, and the default embed code uses the full width of its column. Set a fixed width in the builder if your theme needs one, and keep the suggested height so nothing is cut off.' },
];
const faqLd = JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))});
const appLd = JSON.stringify({"@context":"https://schema.org","@type":"WebApplication","name":"Dead hang timer widget","url":"https://deadhangs.com/free-dead-hang-timer-widget/","description":"A free dead hang interval timer you can embed on your own website with an iframe. Runs in the browser, needs no account and stores nothing.","applicationCategory":"HealthApplication","operatingSystem":"Any device with a web browser","browserRequirements":"Requires a modern web browser with JavaScript","isAccessibleForFree":true,"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"publisher":{"@id":"https://deadhangs.com/#organization"}});
---
<Article h1={"Free dead hang timer for your website."} subtitle={"Paste one block of HTML and your visitors get a working interval timer. Free, no account, nothing stored."} crumbs={[{"name":"Timer widget"}]} wide updated={"Published November 2, 2026"} title="Free Dead Hang Timer for Your Website | Embeddable Widget" description="Add a free dead hang timer to your website. Pick the hang, rest, rounds and theme, copy the embed code and paste it in. No account, no analytics, nothing stored." schema={`<script type="application/ld+json">${appLd}</script><script type="application/ld+json">${faqLd}</script>`}>
<div class="article-body widget-page">
<p>A dead hang timer widget is a small interval timer that sits inside your page in an iframe. Choose the hang time, rest and rounds below, copy the code and paste it into any page that accepts custom HTML.</p>

<section class="wb" aria-labelledby="wb-title">
  <h2 id="wb-title" style="margin-top:0">Build your embed code</h2>
  <div class="wb-grid">
    <div class="wb-controls">
      <form id="wb-form" class="wb-form" novalidate>
        <div class="wb-field"><label for="wb-work">Hang time, seconds ({L.work.min} to {L.work.max})</label><input id="wb-work" name="work" type="number" inputmode="numeric" min={L.work.min} max={L.work.max} step={L.work.step} value={L.work.def} /></div>
        <div class="wb-field"><label for="wb-rest">Rest, seconds ({L.rest.min} to {L.rest.max})</label><input id="wb-rest" name="rest" type="number" inputmode="numeric" min={L.rest.min} max={L.rest.max} step={L.rest.step} value={L.rest.def} /></div>
        <div class="wb-field"><label for="wb-rounds">Rounds ({L.rounds.min} to {L.rounds.max})</label><input id="wb-rounds" name="rounds" type="number" inputmode="numeric" min={L.rounds.min} max={L.rounds.max} step={L.rounds.step} value={L.rounds.def} /></div>
        <fieldset class="wb-field wb-radios"><legend>Theme</legend>
          <label class="wb-opt"><input type="radio" name="theme" value="dark" checked /> Dark</label>
          <label class="wb-opt"><input type="radio" name="theme" value="light" /> Light</label>
        </fieldset>
        <div class="wb-field"><label for="wb-width">Width</label>
          <select id="wb-width" name="width">
            <option value="100%" selected>Full width of its column</option>
            <option value="300px">300 pixels</option>
            <option value="400px">400 pixels</option>
            <option value="500px">500 pixels</option>
            <option value="640px">640 pixels</option>
          </select>
        </div>
        <label class="wb-opt wb-credit"><input type="checkbox" name="credit" checked /> Include the optional credit line</label>
      </form>
      <div class="wb-code">
        <label for="wb-code">Embed code</label>
        <textarea id="wb-code" readonly rows="7" spellcheck="false" set:text={initialCode}></textarea>
        <div class="wb-actions"><button type="button" class="dh-btn" id="wb-copy" disabled>Copy embed code</button><p id="wb-status" class="small-copy" role="status"></p></div>
      </div>
    </div>
    <div class="wb-preview">
      <p class="wb-preview-label">Live preview</p>
      <div class="wb-frame"><iframe id="wb-iframe" src="/embed/timer/" title="Live preview of the dead hang timer widget" width="100%" height="600" loading="lazy" style="border:0;max-width:100%;"></iframe></div>
    </div>
  </div>
  <noscript><p>The builder needs JavaScript. Without it, copy this code and edit the values by hand:</p><pre>{initialCode}</pre></noscript>
</section>

<h2>How do you add the dead hang timer to your website?</h2>
<p>You add the dead hang timer by pasting an iframe into the HTML of a page. The builder above writes the code for you, so no coding is needed. Any editor with a custom HTML or embed block can hold it.</p>
<ol class="stop-steps">
<li>Set the hang time, rest, rounds, theme and width in the builder.</li>
<li>Check the live preview and press Start to see it count.</li>
<li>Press Copy embed code.</li>
<li>In your editor, add a custom HTML or embed block and paste the code.</li>
<li>Publish the page and open it once to confirm the timer loads.</li>
</ol>

<h2>Do you have to credit DeadHangs.com?</h2>
<p>No. The credit line is optional, and the timer works the same without it. If you keep it, the code adds one visible line under the timer: "Dead hang timer by DeadHangs.com", with a single link to the training log page. Untick the box in the builder to leave it out.</p>
<p>The anchor is the brand name only. The widget also shows a small "Timer by DeadHangs.com" link inside the frame.</p>

<h2>Does the dead hang timer widget store or track anything?</h2>
<p>The widget stores nothing in the visitor's browser, sends no analytics and needs no account. It sets no cookies and loads no tracking scripts, so it needs no cookie banner. The visitor sets a session, taps Start and the timer counts in their own browser tab.</p>
<ul>
<li>No sign-up, login or API key for you or your visitors.</li>
<li>No hang times or settings leave the browser.</li>
<li>No Max test mode, because that mode offers to save a result. The embedded timer has simple, EMOM and ladder modes only.</li>
</ul>
<p>The timer is a stopwatch, not medical advice. Add a pointer to the <a href="/deadhang-safety/">dead hang safety guide</a> on your page if your readers are new to hanging.</p>

<h2>What can visitors change inside the widget?</h2>
<p>Visitors can switch between simple, EMOM and ladder modes, change hang time, rest and rounds, add a 5 or 10 second get-ready countdown, and mute the sound. Your embed settings are the starting values. Limits are {L.work.min} to {L.work.max} seconds of hanging, {L.rest.min} to {L.rest.max} seconds of rest and {L.rounds.min} to {L.rounds.max} rounds.</p>

<h2>Frequently asked questions</h2>
{faqs.map(f=><div class="faq"><h3>{f.q}</h3><p>{f.a}</p></div>)}
<p><a class="text-link" href="/training-log/">Open the full timer and training log</a></p>
</div>
</Article>

<style is:global>
  .widget-page .wb { border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-md); padding: 20px; margin: 20px 0 32px; }
  .widget-page .wb-grid { display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .widget-page .wb-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; } }
  .widget-page .wb-form { display: grid; gap: 14px; }
  .widget-page .wb-field { display: grid; gap: 6px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .widget-page .wb label, .widget-page .wb legend { font-size: 14px; color: var(--color-text-muted); font-weight: 600; }
  .widget-page .wb input[type="number"], .widget-page .wb select, .widget-page .wb textarea { box-sizing: border-box; width: 100%; min-height: 44px; padding: 8px 12px; font: 16px var(--font-body); color: var(--color-text); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .widget-page .wb textarea { font-family: var(--font-mono); font-size: 13px; line-height: 1.5; resize: vertical; margin-top: 6px; }
  .widget-page .wb-radios { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; }
  .widget-page .wb-opt { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; cursor: pointer; color: var(--color-text); }
  .widget-page .wb-opt input { width: 20px; height: 20px; }
  .widget-page .wb :is(input, select, textarea, button):focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
  .widget-page .wb-code { margin-top: 20px; }
  .widget-page .wb-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 10px; }
  .widget-page .wb-actions .dh-btn { min-height: 44px; }
  .widget-page .wb-actions p { margin: 0; }
  .widget-page .wb-preview-label { margin: 0 0 8px; font-size: 14px; font-weight: 600; color: var(--color-text-muted); }
  .widget-page .wb-frame { min-height: 600px; border: 1px dashed var(--color-border); border-radius: var(--radius-sm); overflow: hidden; }
  .widget-page .wb-frame iframe { display: block; margin: 0 auto; }
</style>
<script>
  import { buildEmbedCode, buildEmbedUrl, parseEmbedParams } from '../../lib/embed-params.mjs';
  const form = document.getElementById('wb-form') as HTMLFormElement;
  const code = document.getElementById('wb-code') as HTMLTextAreaElement;
  const iframe = document.getElementById('wb-iframe') as HTMLIFrameElement;
  const copy = document.getElementById('wb-copy') as HTMLButtonElement;
  const status = document.getElementById('wb-status') as HTMLElement;
  const HEIGHT = 600;
  function values() {
    const f = new FormData(form);
    const input = parseEmbedParams(new URLSearchParams({ work: String(f.get('work')), rest: String(f.get('rest')), rounds: String(f.get('rounds')), theme: String(f.get('theme')) }).toString());
    return { input, width: String(f.get('width')), credit: form.querySelector<HTMLInputElement>('input[name="credit"]')!.checked };
  }
  function update() {
    const { input, width, credit } = values();
    code.value = buildEmbedCode('https://deadhangs.com', input, { width, height: HEIGHT, credit });
    const rel = buildEmbedUrl('', input);
    if (iframe.getAttribute('src') !== rel) iframe.setAttribute('src', rel);
    iframe.style.width = width;
    iframe.setAttribute('width', width === '100%' ? '100%' : width.replace('px', ''));
    status.textContent = '';
  }
  form.addEventListener('input', update);
  form.addEventListener('change', () => {
    const { input } = values();
    for (const k of ['work', 'rest', 'rounds'] as const) (form.elements.namedItem(k) as HTMLInputElement).value = String(input[k]);
    update();
  });
  form.addEventListener('submit', (e) => e.preventDefault());
  copy.disabled = false;
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(code.value);
      status.textContent = 'Embed code copied.';
    } catch {
      code.focus();
      code.select();
      status.textContent = 'Press Ctrl+C or Cmd+C to copy the selected code.';
    }
  });
  update();
</script>
