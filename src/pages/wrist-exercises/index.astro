            <tr><td>Sets × Reps</td><td>3 × 10 to 15 (eccentric only)</td></tr>
            <tr><td>Tempo</td><td>5 sec lowering phase</td></tr>
            <tr><td>Weight</td><td>Very light (1 to 3 lbs to start)</td></tr>
            <tr><td>Duration</td><td>Follow a clinician's advice</td></tr>
          </tbody>
