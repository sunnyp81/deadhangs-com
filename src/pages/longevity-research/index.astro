---
import Article from '../../layouts/Article.astro';
const faqs = [
  { q: "How does grip strength relate to longevity?", a: "Large cohort studies link lower grip strength to a higher risk of death. In the 2015 Lancet PURE study of 139,691 adults, each 5 kg lower grip was associated with a 16% higher all-cause mortality risk. A 2018 UK Biobank study of 502,293 people found the same direction. These are associations, not proof that improving grip lengthens life." },
  { q: "What is a good dead hang time for longevity?", a: "There is no trial-tested longevity target. On his podcast (The Drive, AMA #329, December 2024) Peter Attia said a 'very strong' 40-year-old man should manage at least two minutes and a 'very strong' 40-year-old woman at least 90 seconds. He said to subtract about 10 seconds per decade. This is his target for very strong people and not an average." },
  { q: "Does dead hanging make you live longer?", a: "No study has shown that dead hanging lengthens life. The mortality studies on this page measured grip strength and not hang time. The authors of the Lancet study say further research is needed to test whether improving strength reduces mortality." },
  { q: "Is Peter Attia's 2-minute dead hang benchmark realistic?", a: "It is a podcast target for very strong 40-year-olds, not a measured norm. No study tests it. Measured group averages were 48.4 to 95.4 seconds in recreational athletes and moderately trained men. Missing the target is not a health diagnosis. Compare your hang with your own earlier results instead." },
  { q: "Is grip strength a cause or a marker?", a: "The studies cannot say. Grip may reflect overall health, muscle mass or activity, and observational data cannot separate those. No trial shows that training grip changes mortality. Treat grip as one signal, and ask a clinician about any concern." },
];
const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const faqHtml = faqs.map((f) => `<div class="faq"><h3>${esc(f.q)}</h3><p>${esc(f.a)}</p></div>`).join("\n");
---

