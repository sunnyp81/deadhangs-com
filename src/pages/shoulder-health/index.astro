---
import Article from '../../layouts/Article.astro';
const faqs = [
  { q: "Are dead hangs good for shoulder impingement?", a: "Orthopedic surgeon John M. Kirsch proposed overhead hanging for shoulder impingement in a self-published book (5th ed. 2019). No published randomized trial has tested it (Europe PMC search, October 2026). If you try short holds then stop when you feel sharp pain and see a clinician if it persists." },
  { q: "Why does my shoulder hurt or pinch when I dead hang?", a: "A pinch, catch or ache has several possible causes and cannot be diagnosed from a description. Keep your feet on the ground to reduce the load, and stop if the pain is sharp or lasts after the session. See a physiotherapist or physician if it keeps happening." },
  { q: "Should I do passive or active hangs for shoulder health?", a: "A passive hang stretches the shoulder with the muscles relaxed. An active hang asks the shoulder blade muscles to work. Many people start passive and add active hangs once a 30 second passive hold feels comfortable. A physiotherapist can set the pace if you are recovering from an injury." },
  { q: "Can dead hangs help a rotator cuff injury?", a: "Dead hangs have not been tested as a treatment for rotator cuff injury. Partial tears need a clinician's assessment before any overhead hanging. Full-thickness tears require medical evaluation first. Ask a physician or physiotherapist before hanging with a diagnosed rotator cuff injury." },
];
const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const faqHtml = faqs.map((f) => `<div class="faq"><h3>${esc(f.q)}</h3><p>${esc(f.a)}</p></div>`).join("\n");
