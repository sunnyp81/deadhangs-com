---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TrainingWorkspace from '../components/TrainingWorkspace';
import HangTimer from '../components/HangTimer';
import HangCalculator from '../components/HangCalculator';
import PracticeGraph from '../components/PracticeGraph';
import GearFinder from '../components/GearFinder';
import SignupForm from '../components/SignupForm';
import OneHang from '../components/home/OneHang.astro';
import HangBand from '../components/home/HangBand.astro';
import { hangFigureSvg } from '../lib/hang-figure.js';
import '../styles/figures.css';

const heroFig = hangFigureSvg({ pose: 'dead-hang', hl: 'grip' });
const pillarFigs = [
  hangFigureSvg({ pose: 'supported', hl: 'grip' }),
  hangFigureSvg({ pose: 'dead-hang', sets: 3, hl: 'arms' }),
  hangFigureSvg({ pose: 'active', hl: 'shoulders' }),
];
import '../styles/global.css';
import '../styles/home-interactions.css';
---

<Base title="Dead Hang Training - Workouts, Timer & Protocol" description="Dead hang training with free timers and workout plans. Practice your hangs, track your own progress, and find a training plan.">
  <script is:inline>try{var v=localStorage.getItem('dh.training-log.v1');if(v&&v.indexOf('"seconds"')>-1)document.documentElement.classList.add('has-log')}catch(e){}</script>
  <Nav />
  <main id="main-content" class="hm">

  <!-- HERO: typographic manifesto, moves with scroll -->
  <section id="hero" class="hm-hero">
    <div class="hm-ticker" aria-hidden="true">
      <div class="hm-ticker-track">
          <span>· deadhangs.com ·</span>
          <span>Grip strength × practice ·</span>
          <span>Free training tools ·</span>
          <span>Your own progress ·</span>
          <span>· deadhangs.com ·</span>
          <span>Grip strength × practice ·</span>
          <span>Free training tools ·</span>
          <span>Your own progress ·</span>
          <span>· deadhangs.com ·</span>
          <span>Grip strength × practice ·</span>
          <span>Free training tools ·</span>
          <span>Your own progress ·</span>
      </div>
    </div>

    <div class="hm-hero-inner">
      <div class="hm-eyebrows">
        <span class="dh-eyebrow">Grip strength · Practice · Progress</span>
        <span class="dh-eyebrow">·· Built for practice</span>
      </div>

      <div class="hm-title-wrap">
      <div class="hm-rig" aria-hidden="true"><span class="hm-rig-bar"></span><div class="hm-rig-fig" set:html={heroFig} /></div>
      <h1 class="dh-heavy hm-title">
        <span class="hm-line" style="--i:0;--dx:-3vw"><span class="hm-in">HANG.</span></span>
        <span class="hm-line hm-accent" style="--i:1;--dx:6vw"><span class="hm-in">LONGER.</span></span>
        <span class="hm-line" style="--i:2;--dx:-5vw"><span class="hm-in">TRAIN.</span></span>
        <span class="hm-line hm-muted" style="--i:3;--dx:9vw"><span class="hm-in">BETTER.</span></span>
      </h1>
      </div>

      <div class="hm-bottom">
        <div class="hm-lede-col">
          <p class="dh-display hm-lede">Dead hang training on this site means a bar, a timer and a log of your own holds. Build a repeatable hanging practice one session at a time.</p>
          <a href="#science" class="dh-btn dh-btn-ghost hm-track">Track your progress ↓</a>
        </div>
        <div id="timer" class="home-hero-timer-wrap">
          <div class="dh-eyebrow hm-module">· Module 01 / Hang timer</div>
          <div class="home-hero-timer">
            <h2 class="hero-sr">Start your session</h2>
            <HangTimer client:load compact initialWork={30} initialRest={60} rounds={3} analyticsSource="home" />
            <p class="hero-safety">Stop if anything hurts. <a class="text-link" href="/deadhang-safety/">Read the safety guide</a></p>
          </div>
          <p class="small-copy hero-defaults">Choose manageable intervals. These defaults are editable timer settings and not a prescribed workout.</p>
        </div>
      </div>

      <div class="hm-cue" aria-hidden="true"><span class="hm-cue-line"></span>Scroll · your progress</div>
    </div>
  </section>

  <!-- DATA STRIP -->
  <section id="science" style="background:var(--color-surface);border-top:1px solid var(--color-divider);border-bottom:1px solid var(--color-divider);padding:80px 64px;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="scroll-reveal" style="margin-bottom:40px;">
        <div class="dh-eyebrow" style="margin-bottom:12px;">· Your baseline / your progress</div>
        <h2 class="dh-display" style="font-size:40px;font-weight:500;margin:0;max-width:780px;">The useful benchmark is <span style="color:var(--color-primary);">your last comparable hang.</span></h2>
        <p style="max-width:720px;color:var(--color-text-muted);margin-top:24px;">Use the same bar, grip and assistance when comparing sessions. Record what you actually held in the log. The timer only times a hold and saves nothing automatically.</p>
      </div>
      <div class="scroll-reveal scroll-reveal-d1" style="margin-bottom:1px;">
        <PracticeGraph client:load />
      </div>
      <div class="hm-steps" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--color-divider);border:1px solid var(--color-divider);"><span class="hm-steps-bar" aria-hidden="true"></span>
        {[
          { n: '01', title: 'Set up', detail: 'Same bar · same grip' },
          { n: '02', title: 'Practice', detail: 'Choose your intervals' },
          { n: '03', title: 'Record', detail: 'Log actual hold time' },
          { n: '04', title: 'Compare', detail: 'Like-for-like sessions' },
        ].map(item => <div class="stat-cell"><div class="dh-heavy hm-num" style="font-size:56px;color:var(--color-primary);line-height:1;">{item.n}</div><div class="dh-display" style="font-weight:600;font-size:14px;margin-top:12px;">{item.title}</div><div class="dh-mono" style="font-size:11px;color:var(--color-text-muted);margin-top:4px;">{item.detail}</div></div>)}
      </div>
    </div>
  </section>

  <OneHang />

  <!-- THE CASE: three pillars -->
  <section id="protocol" style="overflow-x:clip;padding:120px 64px;background:var(--color-bg);">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="dh-eyebrow" style="margin-bottom:16px;">§ II · Your practice</div>
      <h2 class="dh-heavy hm-protocol-h" style="font-size:96px;margin:0 0 80px;max-width:900px;line-height:0.95;">
        <span class="hm-slide-l">One bar.</span><br/><span class="hm-slide-r"><span style="color:var(--color-text-muted);">Three ways</span> to start.</span>
      </h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">
        {[
          { n: "01", title: "Learn the setup", body: "Choose a secure bar, a comfortable grip and assistance you can control. Read the setup guide before your first session.", tag: "FOUNDATIONS", href: "/how-to-deadhang/" },
          { n: "02", title: "Make a plan", body: "Use a 4, 8 or 12-week framework to organize practice and review your progress. Adjust the workload to your own starting point.", tag: "CONSISTENCY", href: "/training-programs/" },
          { n: "03", title: "Find your bar", body: "Compare doorway, wall-mounted and freestanding setups. Check fit, installation requirements and the manufacturer’s load rating.", tag: "EQUIPMENT", href: "/equipment-guide/" },
        ].map((p, i) => (
          <div class={`scroll-reveal ${i === 1 ? 'scroll-reveal-d1' : i === 2 ? 'scroll-reveal-d2' : ''}`}>
            <div style="position:relative;padding-top:24px;">
              <div class="hm-pillar-fig" aria-hidden="true" set:html={pillarFigs[i]} />
              <div class="dh-mono hm-slash" aria-hidden="true">/// {p.n}</div>
              <div class="dh-eyebrow" style="margin-bottom:12px;">{p.tag}</div>
              <h3 class="dh-display" style="font-size:34px;font-weight:600;margin:0 0 12px;">{p.title}</h3>
              <p style="font-size:16px;color:var(--color-text-muted);margin:0 0 12px;line-height:1.6;">{p.body}</p>
              <a href={p.href} class="hm-more">Read more →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <HangBand />

  <section id="training-log" class="home-log" style="padding:100px 64px;background:var(--color-bg);"><div style="max-width:1000px;margin:0 auto;"><TrainingWorkspace client:visible showTimer={false} analyticsSource="home" formAction="/" /></div></section>

  <section id="equipment-matcher" style="padding:80px 64px;background:var(--color-surface);border-top:1px solid var(--color-divider);border-bottom:1px solid var(--color-divider);">
    <div style="max-width:1000px;margin:0 auto;" class="scroll-reveal"><GearFinder client:visible /></div>
  </section>

  <!-- PROTOCOL CALCULATOR -->
  <section id="studies" style="padding:100px 64px;background:var(--color-bg);">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="scroll-reveal">
        <div style="text-align:center;margin-bottom:48px;">
          <div class="dh-eyebrow" style="margin-bottom:12px;">· Module 03 / Personal progress</div>
          <h2 class="dh-display" style="font-size:44px;font-weight:600;margin:0;line-height:1.1;">
            Your numbers. Your next target.
          </h2>
        </div>
      </div>
      <div class="scroll-reveal scroll-reveal-d3">
        <HangCalculator client:visible analyticsSource="home" />
      </div>
    </div>
  </section>

  <!-- QUICK LINKS -->
  <section style="padding:80px 64px;background:var(--color-surface);border-top:1px solid var(--color-divider);">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="scroll-reveal" style="text-align:center;margin-bottom:40px;">
        <div class="dh-eyebrow" style="margin-bottom:12px;">· Start learning</div>
        <h2 class="dh-display" style="font-size:36px;font-weight:600;margin:0;">Go deeper.</h2>
      </div>
      <div class="scroll-reveal scroll-reveal-d3 link-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
        {[
          { title: "Dead Hang Times by Age", desc: "Why there are no validated hang-time norms by age", href: "/dead-hang-time-by-age/" },
          { title: "Dead Hang World Record", desc: "Guinness hanging records by category", href: "/dead-hang-world-record/" },
          { title: "Dead Hang Guide", desc: "Form, benefits, and protocols", href: "/deadhang-guide/" },
          { title: "How to Dead Hang", desc: "Step-by-step instructions", href: "/how-to-deadhang/" },
          { title: "Training Programs", desc: "4, 8, and 12-week plans", href: "/training-programs/" },
          { title: "Grip Strength", desc: "Build a stronger grip", href: "/grip-strength/" },
          { title: "Equipment Guide", desc: "Bars, chalk, and grips", href: "/equipment-guide/" },
          { title: "Progressions", desc: "Zero to one-arm hangs", href: "/deadhang-progressions/" },
          { title: "Benefits", desc: "Benefits and evidence limits", href: "/deadhang-benefits/" },
          { title: "Safety", desc: "When to hang, when to stop", href: "/deadhang-safety/" },
        ].map((link) => (
          <a href={link.href} style="display:block;padding:20px;background:var(--color-bg);border:1px solid var(--color-divider);border-radius:var(--radius-sm);transition:border-color 160ms cubic-bezier(0.16,1,0.3,1);" class="link-card">
            <div class="dh-display" style="font-size:16px;font-weight:600;margin-bottom:4px;">{link.title}</div>
            <div style="font-size:13px;color:var(--color-text-muted);">{link.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA / SIGNUP -->
  <section id="signup" style="padding:120px 64px;background:var(--color-primary);color:var(--color-text-inverse);position:relative;overflow:hidden;">
    <div style="max-width:1100px;margin:0 auto;">
      <h2 class="dh-heavy" style="font-size:clamp(64px,9vw,140px);margin:0;line-height:0.92;">
        START<br/>HANGING.
      </h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-top:56px;align-items:end;">
        <p class="dh-display" style="font-size:22px;font-weight:500;margin:0;line-height:1.4;max-width:540px;">
          Start with the free printable session planner. Choose your intervals, record your holds and review your progress. Email updates are optional.
        </p>
        <SignupForm client:visible dark={true} />
      </div>
    </div>
  </section>

  <!-- SOURCES -->
  <section id="sources" style="padding:64px 64px 40px;background:var(--color-bg);border-top:1px solid var(--color-divider);">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="dh-eyebrow" style="margin-bottom:20px;">How this site treats numbers</div>
      <p style="max-width:800px;color:var(--color-text-muted);">Dead hang time depends on your setup, body mass, grip and assistance. Our calculator compares your own entries; it does not assign a population percentile or estimate your lifespan.</p><div class="button-row"><a class="text-link" href="/editorial-standards/">How we handle evidence →</a><a class="text-link" href="/dead-hang-time-by-age/">Understanding age benchmarks →</a></div>
    </div>
  </section>

  </main>
  <Footer />

  <style>
    /* Decorative word behind the signup copy: generated content with empty alt text, so it is not text for assistive tech or contrast checks. */
    #signup::after { content: "HANG" / ""; position: absolute; bottom: -.2em; right: -.1em; z-index: 0; font: 900 clamp(140px, 30vw, 380px)/.8 var(--font-heavy); letter-spacing: -.05em; color: rgba(0,0,0,.06); pointer-events: none; }
    #signup > div { position: relative; z-index: 1; }
    .stat-cell {
      background: var(--color-bg);
      padding: 32px 24px;
    }
    @media (max-width: 768px) {
      #equipment-matcher { padding: 64px 20px !important; }
    }
  </style>

  <style is:global>
    /* Homepage label system: mono uppercase chrome, as Sunny chose it. */
    .hm .dh-eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; }
    .hm .dh-btn, body:has(main.hm) .site-header .dh-btn { font-family: var(--font-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
    .hm .dh-tag { font-family: var(--font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }

    .hm-hero { position: relative; padding: 120px 64px 56px; background: var(--color-bg); overflow-x: clip; --p: 0; }
    .hm-ticker { position: absolute; top: 92px; left: 0; right: 0; overflow: hidden; pointer-events: none; }
    .hm-ticker-track { display: flex; gap: 24px; width: max-content; white-space: nowrap; font: 11px var(--font-mono); letter-spacing: .22em; text-transform: uppercase; color: var(--color-text-faint); transform: translateX(calc(-4% - var(--p) * 22%)); will-change: transform; }
    .hm-hero-inner { position: relative; max-width: 1100px; margin: 0 auto; padding-top: 28px; }
    .hm-eyebrows { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 32px; }
    .hm-title { margin: 0; font-size: clamp(96px, 14vw, 220px); line-height: .9; color: var(--color-text); text-align: left; transform-origin: 0 40%; transform: scale(calc(1 + var(--p) * .12)); will-change: transform; }
    .hm-line { display: block; overflow: hidden; padding-bottom: .04em; margin-bottom: -.04em; transform: translateX(calc(var(--p) * var(--dx, 0px))); }
    .hm-in { display: inline-block; animation: hm-rise 820ms cubic-bezier(.16,1,.3,1) both; animation-delay: calc(var(--i) * 90ms + 60ms); }
    .hm-accent { color: var(--color-primary); }
    .hm-muted { color: var(--color-text-muted); }
    @keyframes hm-rise { from { transform: translateY(62%); } to { transform: none; } }

    .hm-bottom { display: grid; grid-template-columns: 1.15fr minmax(320px, 440px); gap: 48px; margin-top: 64px; align-items: center; }
    .hm-lede { font-size: 28px; font-weight: 500; line-height: 1.3; margin: 0; color: var(--color-text); text-wrap: balance; }
    .hm-track { margin-top: 28px; }
    .hm-module { margin-bottom: 10px; }
    .hm-cue { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 56px; font: 10px var(--font-mono); letter-spacing: .22em; text-transform: uppercase; color: var(--color-text-faint); }
    .hm-cue-line { display: block; width: 1px; height: 40px; background: linear-gradient(var(--color-primary), transparent); transform-origin: top; animation: hm-cue 1.6s cubic-bezier(.16,1,.3,1) 900ms 3 both; }
    @keyframes hm-cue { 0% { transform: scaleY(0); opacity: 1; } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: .25; } }

    /* Hero rig: a bar across the title with one figure hanging from it (desktop only). */
    .hm-title-wrap { position: relative; font-size: clamp(96px, 14vw, 220px); }
    .hm-rig { display: none; }
    @media (min-width: 1100px) {
      .hm-eyebrows { margin-bottom: 56px; }
      .hm-rig { display: block; position: absolute; inset: 0; pointer-events: none; transform: translateY(calc(var(--p) * -.5em)); opacity: calc(1 - var(--p) * 1.4); }
      .hm-rig-bar { position: absolute; left: 0; right: 0; top: -.14em; height: 4px; border-radius: 2px; background: linear-gradient(90deg, transparent, var(--color-border) 18%, var(--color-text-muted)); transform-origin: right; animation: hm-bar 1100ms cubic-bezier(.16,1,.3,1) 200ms both; }
      .hm-rig-fig { position: absolute; left: 4.3em; top: calc(-.14em - 1.2em * 26 / 158 + 2px); height: 1.2em; width: calc(1.2em * 120 / 158); transform-origin: 50% calc(26 / 158 * 100%); animation: hm-drop 900ms cubic-bezier(.16,1,.3,1) 700ms both, hm-sway 4800ms ease-in-out 1600ms 1; }
      .hm-rig-fig .hf { --hf-max: 100%; height: 100%; width: 100%; --hf-stroke: 3px; }
      .hm-rig-fig .hf-bar { display: none; }
    }
    @keyframes hm-bar { from { transform: scaleX(0); } to { transform: none; } }
    @keyframes hm-drop { from { transform: translateY(-.25em); opacity: 0; } to { transform: none; opacity: 1; } }
    @keyframes hm-sway { 0%, 100% { rotate: 0deg; } 25% { rotate: 2deg; } 60% { rotate: -1.4deg; } 85% { rotate: .6deg; } }

    .hm-pillar-fig { display: flex; align-items: flex-end; width: 84px; height: 104px; margin: 0 0 20px; padding: 6px 4px 0; border-bottom: 1px solid var(--color-divider); }
    .hm-pillar-fig .hf { --hf-max: 76px; height: 100%; width: auto; margin: 0; }

    .hm-steps { position: relative; }
    .hm-steps-bar { position: absolute; top: -1px; left: 0; width: 100%; height: 2px; background: var(--color-primary); transform-origin: left; z-index: 1; }
    .hm-slash { position: absolute; top: 0; left: 0; font-size: 12px; color: var(--color-primary); letter-spacing: .18em; }
    .hm-more { display: inline-flex; align-items: center; min-height: 44px; font: 11px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--color-primary); }
    .hm-more:hover { text-decoration: underline; text-underline-offset: 4px; }
    .hm-slide-l, .hm-slide-r { display: inline-block; }

    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .hm-steps-bar { animation: hm-grow linear both; animation-timeline: view(); animation-range: entry 30% cover 55%; }
        .hm-num { animation: hm-num linear both; animation-timeline: view(); animation-range: entry 0% cover 35%; }
        .hm-slide-l { animation: hm-from-l linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
        .hm-slide-r { animation: hm-from-r linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
        #signup::after { animation: hm-drift linear both; animation-timeline: view(); }
        .hm-pillar-fig .hf { animation: hm-lift linear both; animation-timeline: view(); animation-range: entry 10% cover 40%; }
        .link-card { animation: hm-card linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
        .link-card:nth-child(4n+2) { animation-range: entry 10% entry 100%; }
        .link-card:nth-child(4n+3) { animation-range: entry 20% cover 55%; }
        .link-card:nth-child(4n+4) { animation-range: entry 30% cover 60%; }
      }
    }
    @keyframes hm-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    @keyframes hm-num { from { transform: translateY(18px); opacity: .2; } to { transform: none; opacity: 1; } }
    @keyframes hm-from-l { from { transform: translateX(-14vw); opacity: .15; } to { transform: none; opacity: 1; } }
    @keyframes hm-from-r { from { transform: translateX(14vw); opacity: .15; } to { transform: none; opacity: 1; } }
    @keyframes hm-lift { from { transform: translateY(26px) rotate(-4deg); } to { transform: none; } }
    @keyframes hm-card { from { transform: translateY(32px); } to { transform: none; } }
    @keyframes hm-drift { from { transform: translateX(18%); } to { transform: translateX(-6%); } }

    @media (max-width: 1023px) {
      .hm-bottom { grid-template-columns: 1fr; gap: 32px; }
      .hm-lede { max-width: 40ch; }
      .home-hero-timer-wrap { max-width: 480px; width: 100%; }
    }
    @media (max-width: 768px) {
      .hm-hero { padding: 92px 20px 40px; }
      .hm-ticker { top: 80px; }
      .hm-hero-inner { padding-top: 24px; }
      .hm-eyebrows { flex-direction: column; gap: 6px; margin-bottom: 20px; }
      .hm-title { font-size: clamp(56px, 18vw, 96px); }
      .hm-bottom { margin-top: 32px; gap: 24px; }
      .hm-lede { font-size: 20px; }
      .hm-track { width: 100%; justify-content: center; margin-top: 20px; }
      .hm-cue { margin-top: 36px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hm-title, .hm-line, .hm-ticker-track { transform: none !important; }
      .hm-in, .hm-cue-line, .hm-rig-bar, .hm-rig-fig { animation: none !important; }
      .hm-rig { transform: none !important; }
      .hm-rig { opacity: 1 !important; }
    }
  </style>
  <script>
    const hero = document.getElementById('hero');
    if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let queued = 0;
      const update = () => {
        queued = 0;
        const p = Math.min(1, Math.max(0, window.scrollY / Math.max(400, hero.offsetHeight * 0.75)));
        hero.style.setProperty('--p', p.toFixed(4));
      };
      window.addEventListener('scroll', () => { if (!queued) queued = requestAnimationFrame(update); }, { passive: true });
      update();
    }
  </script>

</Base>
