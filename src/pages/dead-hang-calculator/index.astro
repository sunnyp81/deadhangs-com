import Article from '../../layouts/Article.astro';
import HangCalculator from '../../components/HangCalculator';
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Dead Hang Calculator', url: 'https://deadhangs.com/dead-hang-calculator/', applicationCategory: 'HealthApplication', operatingSystem: 'Any', description: 'Compare a dead hang with your own target and previous hold. No population percentile is calculated.', offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' } };
---
<Article title="Dead Hang Calculator: Compare Your Time & Track Progress" description="Compare your dead hang time with a personal target and previous hold. Free calculator with clear results, training links and no invented percentiles." schema={'<script type="application/ld+json">' + JSON.stringify(schema) + '</script>'}>
  <div class="article-header"><div class="article-breadcrumb"><a href="/">Home</a><span class="sep">/</span>Calculator</div><h1 class="article-h1">Your hang. Your next target.</h1><p class="article-subtitle">Compare a dead hang with your own target and previous result. Get a useful number without pretending to rank you against the population.</p></div>
  <div class="article-body">
    <section aria-label="Dead hang calculator"><HangCalculator client:load /><noscript><p>The interactive calculator needs JavaScript. Calculate your target progress by dividing your hold time by your target, then multiplying by 100.</p></noscript></section>
    <h2 id="reading-results">How the comparison works</h2>
    <p>A 30-second hold against a 60-second target is 50% of your goal. If your previous hold was 20 seconds, the same result is an improvement of 10 seconds or 50%. These percentages describe your own entries.</p>
    <p>The calculator accepts zero for your current hold. A target or previous hold must be greater than zero because it is used as a divisor. It does not store your inputs.</p>
    <h2 id="standards">Can this calculate a percentile by age?</h2>
    <p>No. The research cited by this site does not establish population dead-hang percentiles by age and sex. Dodds and colleagues measured handgrip force with dynamometers. A timed bodyweight hang is a different test.</p>
    <p><a href="https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0113637">Read the Dodds et al. study and its methods</a>. The <a href="/dead-hang-time-by-age/">age guide</a> explains what can and cannot be inferred from these measurements.</p>
    <h2 id="factors">Keep repeat tests comparable</h2>
    <p>Use the same bar, grip position and assistance. Record a feet-supported hold separately from an unassisted one. Note a change of equipment before comparing results. Stop if a hold causes pain and step down under control.</p>
    <h2 id="improve">Turn a result into a routine</h2>
    <p>Choose a manageable session rather than testing a maximum every time. The free workspace has editable hang and rest intervals plus a log stored on your device.</p>
    <div class="button-row"><a class="dh-btn" href="/training-log/">Open timer & log</a><a class="text-link" href="/training-programs/">Choose a training plan</a></div>
    <h2 id="faq">Calculator questions</h2>
    <details class="answer"><summary>Is 60 seconds a required standard?</summary><p>No. It is simply the calculator's editable example target. Set a target that fits your experience and current ability.</p></details>
    <details class="answer"><summary>Does a longer hang predict how long I will live?</summary><p>No individual lifespan can be calculated from this result. Observational research on handgrip strength does not establish that adding seconds to a hang will extend life.</p></details>
    <details class="answer"><summary>Can I compare an assisted hold with an unassisted hold?</summary><p>Keep them separate. Supporting some weight with your feet changes the task. The training log separates these categories.</p></details>
  </div>
</Article>
