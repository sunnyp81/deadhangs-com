  .bar-m { background: #00e5ff; color: #04222a; }
  .bar-f { background: repeating-linear-gradient(135deg, #ffb020 0 6px, #e69a10 6px 12px); color: #2a1a00; }

  .ruler { position: relative; padding: 48px 20px 54px; background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-md); }
  .ruler-track { position: relative; height: 26px; background: var(--color-surface-2); border: 1px solid var(--color-border); }
