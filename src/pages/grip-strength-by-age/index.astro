  .ruler-ticks span { position: absolute; transform: translateX(-50%); font: 12px var(--font-mono); color: #9aa8c4; }
  .ruler-marks { position: absolute; left: 20px; right: 20px; top: 14px; height: 28px; }
  .ruler-marks .mark { position: absolute; font: 600 12px var(--font-mono); color: var(--color-text); white-space: nowrap; transform: translateX(-100%); padding-right: 6px; border-right: 2px solid var(--color-text); }
  .ruler-marks .mark-2 { transform: none; padding: 0 0 0 6px; border-right: 0; border-left: 2px solid var(--color-text); top: 0; }
  .ruler-marks .mark { top: 0; }
</style>
