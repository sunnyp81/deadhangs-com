---
import Article from '../../layouts/Article.astro';
---

<Article
  title="Contact DeadHangs.com: Questions, Corrections and Enquiries"
  description="Contact DeadHangs.com - reach our team with questions about dead hang training, content corrections, or advertising enquiries."
  canonical="https://deadhangs.com/contact/"
  schema={`<script type="application/ld+json">{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact DeadHangs.com",
    "description": "Get in touch with the DeadHangs.com team.",
    "publisher": {
      "@type": "Organization",
      "name": "DeadHangs.com",
      "url": "https://deadhangs.com",
      "email": "hello@deadhangs.com"
    },
    "mainEntityOfPage": "https://deadhangs.com/contact/"
  }</script>`}
>
  <div class="article-header">
    <div class="article-breadcrumb">
      <a href="/">Home</a><span class="sep">/</span>Contact Us
    </div>
  </div>
  <div class="article-body">
    <Fragment set:html={`<div class="content">
    

    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a><span>›</span> Contact</div>
      <div class="page-header">
        <h1>Contact Us</h1>
        <p class="subtitle">Questions about training, content corrections, or partnerships - we read every message.</p>
      </div>

      <div class="contact-grid">
        <div class="contact-card">
          <h2>General Enquiries</h2>
          <p>Questions about dead hang training, programming advice, or site content.</p>
          <a href="mailto:hello@deadhangs.com" class="email-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h14a1 1 0 001-1V5a1 1 0 00-1-1H3zm0 2.586l7 4.667 7-4.667V15H3V6.586z"/></svg>
            hello@deadhangs.com
          </a>
        </div>
        <div class="contact-card">
          <h2>Content Corrections</h2>
          <p>Spotted an error in our data or training guidance? We take accuracy seriously and will update content promptly.</p>
          <a href="mailto:hello@deadhangs.com?subject=Content+Correction" class="email-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h14a1 1 0 001-1V5a1 1 0 00-1-1H3zm0 2.586l7 4.667 7-4.667V15H3V6.586z"/></svg>
            hello@deadhangs.com
          </a>
        </div>
      </div>

      <div class="contact-form">
        <h2>Send a Message</h2>
        <p>We aim to respond within 2 business days. Please be specific - training questions get the best answers with your current hold time, age, and training history.</p>

        <form id="contact-form" action="https://api.staticforms.xyz/submit" method="POST">
          <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749">
          <input type="hidden" name="_site" value="deadhangs.com">
          <input type="hidden" name="subject" value="DeadHangs.com Contact Form">
          <input type="hidden" name="replyTo" value="@">
          <input type="hidden" name="redirectTo" value="https://deadhangs.com/contact/?sent=1">

          <div class="form-group">
            <label for="name">Your Name</label>
            <input type="text" id="name" name="name" placeholder="e.g. Alex" required>
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required>
          </div>
          <div class="form-group">
            <label for="subject-select">Topic</label>
            <select id="subject-select" name="$subject">
              <option value="Training question">Training question</option>
              <option value="Content correction">Content correction</option>
              <option value="Partnership or advertising">Partnership or advertising</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Your message..." required></textarea>
          </div>
          <button type="submit" class="form-submit">Send Message</button>
          <p class="form-note">We do not share your contact details with third parties. See our <a href="/privacy/">Privacy Policy</a>.</p>
        </form>

        <div class="success-msg" id="success-msg">
          Message sent - thank you. We will reply within 2 business days.
        </div>
      </div>

      <div class="callout">
        <p><strong>Looking for training help?</strong> Start with our <a href="/deadhang-guide/">complete dead hang guide</a> or the <a href="/dead-hang-time-by-age/">time-by-age standards</a> - most common questions are answered there.</p>
      </div>
    </div>

    
  </div>`} />
  </div>

<!-- Post-submit confirmation. On a static build Astro.url.searchParams is empty at
     runtime, so the ?sent=1 check has to happen client side or the visitor sees the
     same empty form and assumes the send failed. -->
<script is:inline>
  (function () {
    if (new URLSearchParams(window.location.search).get('sent') !== '1') return;
    var run = function () {
      var forms = document.querySelectorAll('form');
      for (var i = 0; i < forms.length; i++) {
        var f = forms[i];
        // only swap forms that actually post to the form service
        if (!f.querySelector('[name="redirectTo"], [name="redirect"]')) continue;
        var box = document.createElement('div');
        box.setAttribute('role', 'status');
        box.style.cssText = 'border:1px solid currentColor;border-radius:8px;padding:1.25rem 1.5rem;margin:0 0 1.5rem;line-height:1.5';
        box.innerHTML = '<strong>Thanks, your message has been sent.</strong><br>We have received it and will be in touch.';
        f.parentNode.insertBefore(box, f);
        f.hidden = true;
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>
</Article>
