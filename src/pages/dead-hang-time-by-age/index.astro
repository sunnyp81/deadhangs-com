---
import Article from '../../layouts/Article.astro';
import YourNumberCard from '../../components/YourNumberCard';
const faqs = [["What is a good dead hang time?","A useful starting point is a controlled hold you can repeat without pain. Use 10, 30, 60 or 120 seconds as personal milestones if they suit you. They are not population averages. Compare repeat tests under the same conditions."],["How long should a 40-year-old be able to dead hang?","The sources cited here do not establish a required time for a 40-year-old. Training experience, bodyweight, grip, bar and assistance all affect the task. Record your own baseline instead of treating an age table as a pass or fail."],["Is a two-minute dead hang good?","Two minutes is Peter Attia's target for a very strong 40-year-old man. This site cannot assign it a verified population percentile. It is not necessary to reach two minutes before a session counts as useful practice."],["Does dead hang time decrease with age?","Handgrip-force studies show age-related differences across groups. They do not tell us a fixed number of hanging seconds lost per decade. Your own repeated measurements are more useful than subtracting seconds from an invented age norm."],["What is a good dead hang time for a woman?","No single women’s pass time is supported by the sources on this page. Record the same grip and assistance over time. Population handgrip-force differences cannot be converted directly into a timed-hang ranking."],["How long can the average person hang from a bar?","We cannot verify one population average from the studies cited here. A bar hang measures a different task from the dynamometer tests used in the referenced grip-strength research. The main measured timed-hang sample is a 2025 study of 25 young athletes and is summarized on this page."]];
const extraFaqs = [
["What is the average dead hang time?","No large population study of dead hang time exists. One 2025 study of 25 trained recreational athletes aged about 20 measured men at 64 seconds on average and women at 48 seconds. Treat these as one measured sample and not a norm."],
["Is a 1-minute dead hang good?","A one-minute dead hang is close to the 64-second average of the men in one 2025 study of trained recreational athletes aged about 20 and above the 48-second average of the women. It is below Peter Attia's two-minute target for a very strong 40-year-old man. These are different groups. Treat it as a rough comparison."],
["How long should I dead hang in a session?","A Level 1 session is a few short hangs that stop just before your grip fails.","#how-long-per-session"],
["What dead hang time does Peter Attia suggest for a strong 40-year-old?","He said on The Peter Attia Drive (episode 329, December 2024) that a very strong 40-year-old man should be able to dead hang for at least two minutes and a very strong 40-year-old woman for at least 90 seconds. He said to subtract about 10 seconds per decade. It is his target for very strong people and not an average or measured data."],
["What is an elite dead hang time?","No measured threshold for elite exists. Attia's two minutes for a very strong 40-year-old man is a target for strong people and not a population figure. The Guinness World Record for the dead hang position is 80 minutes 41 seconds. Kenta Adachi of Japan set it on 18 November 2022."]
];
const allFaqs = [...faqs, ...extraFaqs];
const dateModified = '2026-11-01';
const faqSchema = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":allFaqs.map(([q,a])=>({"@type":"Question","name":q,"acceptedAnswer":{"@type":"Answer","text":a}}))};
const articleSchema = {"@context":"https://schema.org","@type":"Article","headline":"Dead Hang Times by Age Chart: Men & Women","description":"What is a good dead hang time? No measured norm exists. Young athletes averaged 64 s (men) and 48 s (women) in one study; Attia's 40s target is 90 to 120 s.","dateModified":dateModified,"mainEntityOfPage":"https://deadhangs.com/dead-hang-time-by-age/","author":{"@id":"https://deadhangs.com/#organization"},"publisher":{"@id":"https://deadhangs.com/#organization"},"citation":[
{"@type":"ScholarlyArticle","name":"Impact of 6-Week Combined Gym and Climbing Training on Handgrip Strength and Arm Size: GRIP-6 Study","url":"https://doi.org/10.3390/jfmk10040427"},
{"@type":"ScholarlyArticle","name":"Grip strength across the life course: normative data from twelve British studies","url":"https://doi.org/10.1371/journal.pone.0113637"},
{"@type":"ScholarlyArticle","name":"An investigation of the tri-bar gripping system on isometric muscular endurance","url":"https://doi.org/10.1519/R-13883.1"}]};
const jsonLd = [faqSchema, articleSchema].map(o=>'<script type="application/ld+json">' + JSON.stringify(o) + '</script>').join('');
---
