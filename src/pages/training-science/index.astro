---
import Article from '../../layouts/Article.astro';
const faqs = [
  { q: "Is there scientific research on dead hang training?", a: "Very little. Most guidance here comes from general strength training practice. The GRIP-6 study (Chomiuk et al. 2025) measured 25 recreational athletes and found mean hangs of 55.3 seconds before and 60.9 seconds after six weeks of training. That is one small study, not a prediction for you." },
  { q: "Do dead hangs strengthen tendons?", a: "Sustained loading is a plausible stimulus for tendon adaptation. No study has tested dead hangs on finger flexor or rotator cuff tendons. This is untested." },
  { q: "How often should I deload during dead hang training?", a: "A lighter week about every fourth week is a common coaching convention. It is not a tested rule. A common approach is to cut total hang time per session by about half and keep the same number of sessions." },
  { q: "Is it better to train grip endurance or grip strength with dead hangs?", a: "Training both grip endurance and grip strength benefits many people. Long bodyweight holds emphasize endurance and short heavy holds emphasize peak force. This comes from general strength training principles and not from dead hang studies." },
  { q: "How do I know if I am overtraining my grip?", a: "Flat or declining max hold times over two or more consecutive weeks can be a sign of overtraining. Other signs include persistent forearm tightness, dull elbow ache and reduced grip strength in daily tasks. Persistent symptoms need a clinician, not only a deload." },
];
const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const faqHtml = faqs.map((f) => `<div class="faq"><h3>${esc(f.q)}</h3><p>${esc(f.a)}</p></div>`).join("\n");
---

