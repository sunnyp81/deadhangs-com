---
import Article from '../../layouts/Article.astro';
const faqs = [
  { q: "Does a dead hang decompress the spine?", a: "A dead hang takes your body weight through your arms, so the spine carries less compressive load while you hang. No study has measured disc height or pressure during a bodyweight hang, and a Cochrane review found traction gives little or no benefit for low back pain." },
  { q: "Can dead hangs help sciatica?", a: "No trial has tested dead hangs for sciatica. Some people online report relief and others report more pain, and those accounts are not evidence. Radiating leg pain, weakness or numbness needs a clinician's assessment. Stop hanging if it increases symptoms." },
  { q: "Why does my lower back hurt when I dead hang?", a: "A description cannot show the cause. Reports include aching, a pull, tingling and popping. Sharp, shooting or lasting pain means stop. Keep your feet on the ground to reduce the load, and see a clinician if the pain keeps coming back." },
  { q: "How long should I dead hang for back stiffness?", a: "Common practice is 15 to 30 second hangs for 3 to 4 sets, on 3 non-consecutive days a week. This is common training practice and not a tested prescription. No trial has tested a dose for back stiffness. Stop if symptoms worsen, and see a clinician if stiffness has not eased." },
  { q: "Can dead hangs help a herniated disc?", a: "No evidence shows that dead hangs help a herniated disc. Some people report that hanging aggravates their disc problem. See a physician or physiotherapist before hanging with a diagnosed herniation." },
  { q: "Are dead hangs better than inversion tables for back pain?", a: "No head-to-head trial was found. Dead hangs and inversion tables both apply traction by different methods. People with high blood pressure or eye conditions should ask a clinician before inverting. Inversion tables may suit people who cannot grip a bar." },
];
const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const faqHtml = faqs.map((f) => `<div class="faq"><h3>${esc(f.q)}</h3><p>${esc(f.a)}</p></div>`).join("\n");
