---
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = 'Dead hang training protocols, timers, and the science behind grip strength and longevity.', ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://deadhangs.com');
// homepage_banner.png is a real 1200x630 asset in public/images — never point og:image at a file that does not exist.
const ogImageURL = new URL(ogImage || '/images/homepage_banner.png', Astro.site || 'https://deadhangs.com').href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="DeadHangs.com" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://deadhangs.com/#organization",
        "name": "DeadHangs.com",
        "url": "https://deadhangs.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://deadhangs.com/favicon.svg"
        },
        "sameAs": []
      },
      {
        "@type": "WebSite",
        "@id": "https://deadhangs.com/#website",
        "url": "https://deadhangs.com",
        "name": "DeadHangs.com",
        "description": "Dead hang training protocols, timers, and the science behind grip strength and longevity.",
        "publisher": { "@id": "https://deadhangs.com/#organization" }
      }
    ]
  })} />
  <link rel="preload" href="/fonts/archivo-black.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-tight.woff2" as="font" type="font/woff2" crossorigin />
  <Analytics />
  <script>
    import { trackAffiliateClick } from '../scripts/affiliate-tracking.js';
    document.addEventListener('click', (event) => trackAffiliateClick(event));
    document.addEventListener('auxclick', (event) => trackAffiliateClick(event));
  </script>
</head>
<body>
  <slot />
  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
  </script>
  <CookieConsent />
</body>
</html>
