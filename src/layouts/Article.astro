---
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import fs from 'node:fs';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/article.css';

// Only ever reference banners that actually exist on disk, so og:image can never 404.
const BANNERS = new Set(fs.readdirSync('public/images').filter(f => f.endsWith('_banner.png')));

interface Props {
  title: string;
  description: string;
  datePublished?: string;
  dateModified?: string;
  schema?: string;
  canonical?: string;
  ogImage?: string;
}

const { title, description, datePublished, dateModified, schema, canonical, ogImage } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || 'https://deadhangs.com').href;

const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ownBanner = BANNERS.has(`${slug}_banner.png`) ? `/images/${slug}_banner.png` : null;
const ogImageURL = new URL(ogImage || ownBanner || '/images/homepage_banner.png', Astro.site || 'https://deadhangs.com').href;

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://deadhangs.com/" }
];
segments.forEach((seg, i) => {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": i + 2,
    "name": seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
    "item": `https://deadhangs.com/${segments.slice(0, i + 1).join('/')}/`
  });
});

const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://deadhangs.com/#organization",
      "name": "DeadHangs.com",
      "url": "https://deadhangs.com",
      "logo": { "@type": "ImageObject", "url": "https://deadhangs.com/favicon.svg" }
    },
    {
      "@type": "WebSite",
      "@id": "https://deadhangs.com/#website",
      "url": "https://deadhangs.com",
      "name": "DeadHangs.com",
      "publisher": { "@id": "https://deadhangs.com/#organization" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems
    }
  ]
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="DeadHangs.com" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
  {schema && <Fragment set:html={schema} />}
  <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-tight.woff2" as="font" type="font/woff2" crossorigin />
  <Analytics />
  <script>
    import { trackAffiliateClick } from '../scripts/affiliate-tracking.js';
    document.addEventListener('click', (event) => trackAffiliateClick(event));
    document.addEventListener('auxclick', (event) => trackAffiliateClick(event));
  </script>
</head>
<body>
  <Nav />
  <main id="main-content" class="article-main">
    <slot />

  </main>
  <Footer />
  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
  </script>
  <CookieConsent />
</body>
</html>
