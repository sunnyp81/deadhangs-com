// Preview and local development use the isolated database. Secrets are environment-specific.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deadhangs-com",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NODE_VERSION": "22",
    "AUTH_BASE_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deadhangs-accounts-preview",
      "database_id": "a0c76057-9b90-4df8-8a89-b901d1b3ec00",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "NODE_VERSION": "22",
        "AUTH_BASE_URL": "https://codex-accounts-paid-20261107.deadhangs-com-bew.pages.dev",
        "BILLING_ENABLED": "true",
        "BILLING_MODE": "test",
        "BILLING_LAUNCH_ENABLED": "false",
        "STRIPE_ACCOUNT_ID": "acct_1UZYZeEiamtoGTBs",
        "STRIPE_PRODUCT_ID": "prod_VakEnBwJGAzVa2",
        "STRIPE_MONTHLY_PRICE_ID": "price_1UZYkKEiamtoGTBsNK8N4lTG",
        "STRIPE_YEARLY_PRICE_ID": "price_1UZYkKEiamtoGTBsMwIJt4OG",
        "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1UZYmoEiamtoGTBsUbk2l2oF"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "deadhangs-accounts-preview",
          "database_id": "a0c76057-9b90-4df8-8a89-b901d1b3ec00",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "vars": {
        "NODE_VERSION": "22",
        "AUTH_BASE_URL": "https://deadhangs.com",
        "BILLING_ENABLED": "true",
        "BILLING_MODE": "live",
        "BILLING_LAUNCH_ENABLED": "true",
        "STRIPE_ACCOUNT_ID": "acct_1UZYZTEp4lCx1so6",
        "STRIPE_PRODUCT_ID": "prod_VbEy7boSR7FKx6",
        "STRIPE_MONTHLY_PRICE_ID": "price_1Ua2UxEp4lCx1so6NgBm7GPY",
        "STRIPE_YEARLY_PRICE_ID": "price_1Ua2UyEp4lCx1so6ojJsesO8",
        "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1Ua2UyEp4lCx1so62gnYni3B"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "deadhangs-accounts",
          "database_id": "59ad920f-3a42-4cb2-be65-2bfe64c25231",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
